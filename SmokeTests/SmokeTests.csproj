    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Jellyfin.Plugin.BiliArchive\Jellyfin.Plugin.BiliArchive.csproj" />
  </ItemGroup>
</Project>
