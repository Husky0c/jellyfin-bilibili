<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <JellyfinAbi Condition="'$(JellyfinAbi)' == ''">10.10</JellyfinAbi>
    <TargetFramework Condition="'$(JellyfinAbi)' == '10.10'">net8.0</TargetFramework>
